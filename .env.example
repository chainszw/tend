# Copy to .env.local and fill in. Never commit real values.

# Supabase (Project Settings > API). Server-side only.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# Signs session cookies. Generate: openssl rand -base64 32
SESSION_SECRET=

# Protects /api/cron/reminders. Generate: openssl rand -hex 24
CRON_SECRET=

# Adaption (app.adaptionlabs.ai > Settings > API keys)
ADAPTION_API_KEY=
# Optional: Inference Stack slug grounded on the adapted care-guidance dataset
ADAPTION_STACK_SLUG=
ADAPTION_CHAT_MODEL=gemma-4-31b-it
ADAPTION_FAST_MODEL=deepseek-v4-flash

# Gmail SMTP (Google Account > Security > App passwords)
GMAIL_USER=
GMAIL_APP_PASSWORD=

# Public URL of the deployed app, used in email links
APP_URL=http://localhost:3000

# Optional: "on" shows the Dev mode corner button in production (demo circle, no sign-in)
DEV_MODE=
